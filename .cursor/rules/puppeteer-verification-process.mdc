### Step 4: Force Error Detection
```javascript
const errorCheck = await mcp_puppeteer_puppeteer_evaluate(`
  (function() {
    // Get ALL text content from the page
    const fullPageText = document.documentElement.innerText;
    const errors = [];
    
    // MUST check for these specific error patterns
    const errorPatterns = [
      'Failed to compile',
      'Module not found',
      'Cannot resolve',
      'SyntaxError',
      'TypeError',
      'Error:',
      'webpack',
      'Build Error',
      'Unhandled Runtime Error',
      'Hydration failed'
    ];
    
    // Check if any error pattern exists in the page
    errorPatterns.forEach(pattern => {
      if (fullPageText.includes(pattern)) {
        // Find the specific error message
        const lines = fullPageText.split('\\n');
        const errorLines = lines.filter(line => line.includes(pattern));
        
        errors.push({
          type: 'COMPILATION_ERROR',
          pattern: pattern,
          message: errorLines.join('\\n'),
          fullContext: lines.slice(
            Math.max(0, lines.indexOf(errorLines[0]) - 2),
            Math.min(lines.length, lines.indexOf(errorLines[0]) + 5)
          ).join('\\n')
        });
      }
    });
    
    // Also check for error overlays
    const errorOverlay = document.querySelector('[style*="background-color: rgb(206, 17, 38)"]');
    if (errorOverlay) {
      errors.push({
        type: 'ERROR_OVERLAY',
        message: errorOverlay.innerText
      });
    }
    
    // Check for Next.js specific error elements
    const nextError = document.querySelector('[data-nextjs-error]');
    if (nextError) {
      errors.push({
        type: 'NEXTJS_ERROR',
        message: nextError.innerText
      });
    }
    
    return {
      hasErrors: errors.length > 0,
      errors: errors,
      fullPageText: fullPageText.substring(0, 1000)
    };
  })()
`);
```

