# Frontend Verification Process - MUST DETECT ALL ERRORS

## CRITICAL: The assistant MUST detect and report ALL compilation errors

### Step 1: Check Dev Server Status and Ensure Running Server
```javascript
// Check if dev server is running
const portCheck = await mcp_desktop_commander_execute_command('lsof -i :4000');
let serverWasRestarted = false;

// If something is already on port 4000, check its health
if (portCheck.includes(':4000')) {
  console.log('Dev server detected on port 4000 - checking health...');
  
  // Attempt to verify server health
  try {
    const healthCheck = await mcp_desktop_commander_execute_command('curl -s -o /dev/null -w "%{http_code}" http://localhost:4000');
    
    // Check if server is responding with errors
    if (healthCheck !== "200") {
      console.log('⚠️ Existing server appears unhealthy - will restart');
      
      // Kill the unhealthy server
      await mcp_desktop_commander_execute_command('kill -9 $(lsof -t -i:4000)');
      await new Promise(resolve => setTimeout(resolve, 2000));
      
      // IMMEDIATELY START A NEW SERVER
      console.log('Starting fresh dev server...');
      await mcp_desktop_commander_execute_command('cd /path/to/project && npm run dev 2>&1 | tee dev-server.log &');
      await new Promise(resolve => setTimeout(resolve, 5000));
      serverWasRestarted = true;
      
    } else {
      // Even if 200, check for content health
      const contentCheck = await mcp_desktop_commander_execute_command('curl -s http://localhost:4000');
      if (contentCheck.includes('Error') || contentCheck.includes('failed') || contentCheck.includes('Module not found')) {
        console.log('⚠️ Server responding but content has errors - will restart');
        
        // Kill and immediately restart
        await mcp_desktop_commander_execute_command('kill -9 $(lsof -t -i:4000)');
        await new Promise(resolve => setTimeout(resolve, 2000));
        
        console.log('Starting fresh dev server...');
        await mcp_desktop_commander_execute_command('cd /path/to/project && npm run dev 2>&1 | tee dev-server.log &');
        await new Promise(resolve => setTimeout(resolve, 5000));
        serverWasRestarted = true;
      } else {
        console.log('✓ Existing server appears healthy');
      }
    }
  } catch (error) {
    console.log('⚠️ Server health check failed - will restart');
    // Kill the unresponsive server
    await mcp_desktop_commander_execute_command('kill -9 $(lsof -t -i:4000)');
    await new Promise(resolve => setTimeout(resolve, 2000));
    
    // Start fresh server
    console.log('Starting fresh dev server...');
    await mcp_desktop_commander_execute_command('cd /path/to/project && npm run dev 2>&1 | tee dev-server.log &');
    await new Promise(resolve => setTimeout(resolve, 5000));
    serverWasRestarted = true;
  }
} else {
  console.log('No dev server running - starting fresh');
  await mcp_desktop_commander_execute_command('cd /path/to/project && npm run dev 2>&1 | tee dev-server.log &');
  await new Promise(resolve => setTimeout(resolve, 5000));
  serverWasRestarted = true;
}

// Verify server is now running before proceeding
const finalPortCheck = await mcp_desktop_commander_execute_command('lsof -i :4000');
if (!finalPortCheck.includes(':4000')) {
  console.log('❌ CRITICAL ERROR: Server failed to start');
  return {
    status: 'SERVER_START_FAILED',
    message: 'Development server failed to start on port 4000',
    action: 'Check project setup and dependencies'
  };
}
```

### Step 2: Read Server Output for Errors
