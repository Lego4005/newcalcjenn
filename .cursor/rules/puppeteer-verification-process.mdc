### Step 3: Browser Verification with Recovery
```javascript
let navigationSuccess = false;
let retryCount = 0;
const maxRetries = 3;

while (!navigationSuccess && retryCount < maxRetries) {
  try {
    await mcp_puppeteer_puppeteer_navigate('http://localhost:4000');
    await new Promise(resolve => setTimeout(resolve, 5000));
    navigationSuccess = true;
  } catch (error) {
    retryCount++;
